# ============================================================================
# Zsh Configuration
# ============================================================================

# -- Environment -------------------------------------------------------------

ZDOTDIR=$HOME
ZIM_HOME=$HOME/.config/zsh/.zim
ZIM_CONFIG_FILE=$HOME/.config/zsh/.zimrc

typeset -gU path PATH fpath
path=("$HOME/.local/bin" "$HOME/.cargo/bin" /usr/local/go/bin "${path[@]}")
[[ -d /usr/share/zsh/site-functions ]] && fpath=(/usr/share/zsh/site-functions $fpath)

export GTK_IM_MODULE=ibus
export QT_IM_MODULE=ibus
export XMODIFIERS=@im=ibus
export VCPKG_ROOT="$HOME/vcpkg"
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'
export EZA_COLORS='ex=1;32'
export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"

if [[ -f $HOME/.config/zsh/.dir_colors ]]; then
  local color_init
  color_init=$(dircolors -b "$HOME/.config/zsh/.dir_colors") || return
  eval "$color_init"
  unset color_init
fi

# -- Module Setup ------------------------------------------------------------

typeset -g ZSH_CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/zsh
[[ -d $ZSH_CACHE_DIR ]] || command mkdir -p -- "$ZSH_CACHE_DIR" || return
zstyle ':zim:completion' dumpfile "$ZSH_CACHE_DIR/zcompdump"
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$ZSH_CACHE_DIR/zcompcache"

# Autosuggestions bind once, after all custom widgets have been registered.
ZSH_AUTOSUGGEST_MANUAL_REBIND=1
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20
ZSH_AUTOSUGGEST_USE_ASYNC=1
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_ACCEPT_WIDGETS=(
  forward-char end-of-line vi-forward-char vi-end-of-line vi-add-eol
  deselect-forward-char deselect-end-of-line
)

if [[ ! -r $ZIM_HOME/init.zsh ]]; then
  print -u2 'Zim is not initialized. Run: zsh ~/.config/zsh/bootstrap.zsh'
  return 1
fi
source "$ZIM_HOME/init.zsh" || return

# -- History and Completion --------------------------------------------------

HISTSIZE=1000
SAVEHIST=1000
HISTFILE=$HOME/.zhistory
setopt HIST_IGNORE_SPACE HIST_VERIFY HIST_REDUCE_BLANKS
# Zim's environment module enables SHARE_HISTORY.
setopt HIST_IGNORE_ALL_DUPS
setopt AUTO_MENU COMPLETE_IN_WORD ALWAYS_TO_END

zstyle ':completion:*' completer _complete _match _approximate
zstyle ':completion:*:match:*' original only
zstyle ':completion:*:approximate:*' max-errors 'reply=($((($#PREFIX+$#SUFFIX)/3))numeric)'
zstyle ':completion:*' matcher-list '' \
  'm:{a-zA-Z}={A-Za-z}' \
  'r:|[._-]=* r:|=*' \
  'r:|?=** m:{a-z\-}={A-Z\_}'
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

# -- Vi Mode and Cursor ------------------------------------------------------

bindkey -v
KEYTIMEOUT=1
autoload -Uz add-zsh-hook add-zle-hook-widget

_set_vi_cursor() {
  if [[ $KEYMAP == vicmd ]]; then
    printf '\e[1 q'
  else
    printf '\e[5 q'
  fi
}
_set_insert_cursor() { printf '\e[5 q'; }

# Compose with Zim's terminal-mode hooks instead of replacing them.
add-zle-hook-widget keymap-select _set_vi_cursor
add-zle-hook-widget line-init _set_insert_cursor
add-zsh-hook preexec _set_insert_cursor

# -- Selection Widgets -------------------------------------------------------

_start_selection_if_needed() { [[ $REGION_ACTIVE -eq 0 ]] && zle set-mark-command; }

for widget in forward-char backward-char forward-word backward-word beginning-of-line end-of-line; do
  eval "deselect-${widget}() { [[ \$REGION_ACTIVE -ne 0 ]] && zle deactivate-region; zle ${widget}; }"
  zle -N "deselect-${widget}"
done

for pair in forward:forward-char backward:backward-char up:up-line-or-history down:down-line-or-history \
            forward-word:forward-word backward-word:backward-word \
            beginning-of-line:beginning-of-line end-of-line:end-of-line; do
  name=${pair%%:*} widget=${pair#*:}
  eval "visual-select-${name}() { _start_selection_if_needed; zle ${widget}; }"
  zle -N "visual-select-${name}"
done
unset widget pair name

# -- Fuzzy Finder ------------------------------------------------------------

if (( ${+commands[fzf]} && ${+widgets[fzf-file-widget]} )); then
  export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --bind=ctrl-k:kill-line'
  if (( ${+commands[fd]} )); then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
  fi
  if (( ${+commands[eza]} )); then
    # Zim's -1F preview lets eza consume the directory as --classify's value.
    export FZF_CTRL_T_OPTS=${FZF_CTRL_T_OPTS// -1F / -1 --classify=always -- }
    export FZF_ALT_C_OPTS=${FZF_ALT_C_OPTS// -1F / -1 --classify=always -- }
  fi
  for keymap in viins vicmd; do
    bindkey -M "$keymap" '^T' fzf-file-widget
    bindkey -M "$keymap" '\ec' fzf-cd-widget
    bindkey -M "$keymap" '^R' fzf-history-widget
  done
  unset keymap
fi

# -- Key Bindings ------------------------------------------------------------

# History search.
bindkey -M viins '^[[A' history-substring-search-up
bindkey -M viins '^[[B' history-substring-search-down
bindkey -M vicmd 'k' history-substring-search-up
bindkey -M vicmd 'j' history-substring-search-down

# Movement clears the active selection.
bindkey -M viins '^[[C' deselect-forward-char
bindkey -M viins '^[[D' deselect-backward-char
bindkey -M viins '^[OC' deselect-forward-char
bindkey -M viins '^[OD' deselect-backward-char
bindkey -M viins '^[[1;5C' deselect-forward-word
bindkey -M viins '^[[1;5D' deselect-backward-word
bindkey -M viins '^[^[[C' deselect-forward-word
bindkey -M viins '^[^[[D' deselect-backward-word
bindkey -M viins '^[[H' deselect-beginning-of-line
bindkey -M viins '^[[F' deselect-end-of-line
bindkey -M viins '^[[1~' deselect-beginning-of-line
bindkey -M viins '^[[4~' deselect-end-of-line
bindkey -M viins '^A' deselect-beginning-of-line
bindkey -M viins '^E' deselect-end-of-line

# Delete and backspace.
bindkey -M viins '^[[3~' delete-char
bindkey -M viins '^?' backward-delete-char
bindkey -M viins '^H' backward-delete-char

# Extend selection by character, word, or line.
bindkey -M viins '^[[1;2C' visual-select-forward
bindkey -M viins '^[[1;2D' visual-select-backward
bindkey -M viins '^[[1;2A' visual-select-up
bindkey -M viins '^[[1;2B' visual-select-down
bindkey -M viins '^[[1;6C' visual-select-forward-word
bindkey -M viins '^[[1;6D' visual-select-backward-word
bindkey -M viins '^[[1;2H' visual-select-beginning-of-line
bindkey -M viins '^[[1;2F' visual-select-end-of-line

# -- Lazy Tool Initialization ------------------------------------------------

if (( ${+commands[uv]} && ${+functions[compdef]} )); then
  _uv_lazy_completion() {
    local completion
    completion=$(uv generate-shell-completion zsh) || return
    eval "$completion" || return
    _uv "$@"
  }
  compdef _uv_lazy_completion uv
fi

if (( ${+commands[uvx]} && ${+functions[compdef]} )); then
  _uvx_lazy_completion() {
    local completion
    completion=$(uvx --generate-shell-completion zsh) || return
    eval "$completion" || return
    _uvx "$@"
  }
  compdef _uvx_lazy_completion uvx
fi

export NVM_DIR="$HOME/.nvm"
if [[ -d $NVM_DIR/versions/node ]]; then
  local nvm_default nvm_version_path
  local -a nvm_versions
  if [[ -r $NVM_DIR/alias/default ]]; then
    IFS= read -r nvm_default < "$NVM_DIR/alias/default"
  elif [[ -r $HOME/.nvmrc ]]; then
    IFS= read -r nvm_default < "$HOME/.nvmrc"
  fi
  [[ -n $nvm_default ]] && nvm_versions=("$NVM_DIR/versions/node"/v${~nvm_default}*(Nn))
  (( ${#nvm_versions} )) || nvm_versions=("$NVM_DIR/versions/node"/v*(Nn))
  nvm_version_path=${nvm_versions[-1]}
  [[ -d $nvm_version_path/bin ]] && path=("$nvm_version_path/bin" $path)
  unset nvm_default nvm_version_path nvm_versions
fi

nvm() {
  [[ -s $NVM_DIR/nvm.sh ]] || { print -u2 "Missing NVM: $NVM_DIR/nvm.sh"; return 1; }
  unset -f nvm
  source "$NVM_DIR/nvm.sh" || return
  [[ ! -s $NVM_DIR/bash_completion ]] || source "$NVM_DIR/bash_completion" || return
  nvm "$@"
}

# -- Aliases and Functions ---------------------------------------------------

alias ll='eza -l'
alias la='eza -A'
alias l='eza --classify=always'

rm() {
  local arg
  for arg in "$@"; do
    if [[ "$arg" =~ ^-.*[rf] ]] && [[ "$*" =~ (^|[[:space:]])/([[:space:]]|$) ]]; then
      print -u2 'Error: Deletion of root directory is prohibited'
      return 1
    fi
  done
  command rm "$@"
}

# Retain Yazi's exit status and always remove its temporary cwd file.
y() {
  local cwd_file cwd yazi_exit
  cwd_file=$(mktemp -t 'yazi-cwd.XXXXXX') || return
  {
    env -u NO_COLOR yazi "$@" --cwd-file="$cwd_file"
    yazi_exit=$?
    if (( yazi_exit == 0 )) && [[ -s $cwd_file ]]; then
      cwd=$(<"$cwd_file")
      if [[ -n $cwd && $cwd != $PWD ]]; then
        builtin cd -- "$cwd" || return
      fi
    fi
  } always {
    command rm -f -- "$cwd_file" || return
  }
  return $yazi_exit
}

# -- Prompt and Terminal Integration -----------------------------------------

local tool_init
if [[ ${TERM-} != dumb && ${+commands[starship]} ]]; then
  tool_init=$(starship init zsh) || return
  eval "$tool_init" || return
fi
if (( ${+commands[zoxide]} )); then
  tool_init=$(zoxide init zsh) || return
  eval "$tool_init" || return
fi
unset tool_init

_sync_tmux_graphical_environment() {
  [[ -n ${TMUX-} && -n ${TMUX_PANE-} ]] || return 0
  local tmux_environment
  tmux_environment=$(tmux show-environment -s -t "$TMUX_PANE" DISPLAY \; \
    show-environment -s -t "$TMUX_PANE" XAUTHORITY) || return
  eval "$tmux_environment"
}
if [[ -n ${TMUX-} && -n ${TMUX_PANE-} ]]; then
  add-zsh-hook preexec _sync_tmux_graphical_environment
  _sync_tmux_graphical_environment
fi

if [[ -n ${HERDR_PANE_ID-} ]]; then
  for _har_hook in $HOME/.config/herdr/plugins/github-installations/herdr-automatic-rename-*/*/checkout/shell/hook.zsh(N); do
    source "$_har_hook"
    break
  done
  unset _har_hook
fi
