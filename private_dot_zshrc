# ============================================================================
# Zsh Configuration
# ============================================================================

# -- Zsh Variables and Environment -------------------------------------------

ZDOTDIR=$HOME
ZIM_HOME=$HOME/.config/zsh/.zim
ZIM_CONFIG_FILE=$HOME/.config/zsh/.zimrc

# Command and function search paths.
typeset -gU path PATH fpath
path=("$HOME/.local/bin" "$HOME/.cargo/bin" /usr/local/go/bin "${path[@]}")
fpath=("$HOME/.config/zsh/functions" $fpath)
[[ -d /usr/share/zsh/site-functions ]] && fpath=(/usr/share/zsh/site-functions $fpath)

# User environment.
export GTK_IM_MODULE=ibus
export QT_IM_MODULE=ibus
export XMODIFIERS=@im=ibus
export VCPKG_ROOT="$HOME/vcpkg"
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'
export EZA_COLORS='ex=1;32'
export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"

# NVM and zsh-vi-mode plugin settings.
export NVM_DIR="$HOME/.nvm"
NVM_LAZY_LOAD=true
NVM_AUTO_USE=false
NVM_COMPLETION=false
ZVM_CURSOR_STYLE_ENABLED=true
ZVM_INSERT_MODE_CURSOR=$'\e[5 q'
ZVM_NORMAL_MODE_CURSOR=$'\e[1 q'

# GNU dircolors configuration.
if [[ -f $HOME/.config/zsh/.dir_colors ]]; then
  local color_init
  color_init=$(dircolors -b "$HOME/.config/zsh/.dir_colors") || return
  eval "$color_init"
  unset color_init
fi

# -- Zim Bootstrap and Plugin Setup ------------------------------------------

typeset -g ZSH_CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/zsh
[[ -d $ZSH_CACHE_DIR ]] || command mkdir -p -- "$ZSH_CACHE_DIR" || return
zstyle ':zim:completion' dumpfile "$ZSH_CACHE_DIR/zcompdump"
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$ZSH_CACHE_DIR/zcompcache"

# Autosuggestions rebinds after the custom widgets below are registered.
ZSH_AUTOSUGGEST_MANUAL_REBIND=1
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20
ZSH_AUTOSUGGEST_USE_ASYNC=1
ZSH_AUTOSUGGEST_STRATEGY=(history completion)

if [[ ! -r $ZIM_HOME/init.zsh ]]; then
  print -u2 'Zim is not initialized. Run: zsh ~/.config/zsh/bootstrap.zsh'
  return 1
fi
source "$ZIM_HOME/init.zsh" || return

# -- Zsh Options and Completion ---------------------------------------------

HISTSIZE=1000
SAVEHIST=1000
HISTFILE=$HOME/.zhistory
setopt HIST_IGNORE_SPACE HIST_VERIFY HIST_REDUCE_BLANKS
# Zim's environment module enables SHARE_HISTORY.
setopt HIST_IGNORE_ALL_DUPS
setopt AUTO_MENU COMPLETE_IN_WORD ALWAYS_TO_END

zstyle ':completion:*' completer _complete _match _approximate
zstyle ':completion:*:match:*' original only
zstyle ':completion:*:approximate:*' max-errors 'reply=($((($#PREFIX+$#SUFFIX)/3))numeric)'
zstyle ':completion:*' matcher-list '' \
  'm:{a-zA-Z}={A-Za-z}' \
  'r:|[._-]=* r:|=*' \
  'r:|?=** m:{a-z\-}={A-Z\_}'
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

# -- ZLE Widgets -------------------------------------------------------------

_start_selection_if_needed() { [[ $REGION_ACTIVE -eq 0 ]] && zle set-mark-command; }

for widget in forward-char backward-char forward-word backward-word beginning-of-line end-of-line; do
  eval "deselect-${widget}() { [[ \$REGION_ACTIVE -ne 0 ]] && zle deactivate-region; zle ${widget}; }"
  zle -N "deselect-${widget}"
done

for pair in forward:forward-char backward:backward-char up:up-line-or-history down:down-line-or-history \
            forward-word:forward-word backward-word:backward-word \
            beginning-of-line:beginning-of-line end-of-line:end-of-line; do
  name=${pair%%:*} widget=${pair#*:}
  eval "visual-select-${name}() { _start_selection_if_needed; zle ${widget}; }"
  zle -N "visual-select-${name}"
done
unset widget pair name

# Autosuggestions accepts these custom movement widgets as complete commands.
ZSH_AUTOSUGGEST_ACCEPT_WIDGETS=(
  forward-char end-of-line vi-forward-char vi-end-of-line vi-add-eol
  deselect-forward-char deselect-end-of-line
)

# -- Plugin Integrations -----------------------------------------------------

if (( ${+commands[fzf]} && ${+widgets[fzf-file-widget]} )); then
  export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --bind=ctrl-k:kill-line'
  if (( ${+commands[fd]} )); then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
  fi
  if (( ${+commands[eza]} )); then
    # Zim's -1F preview lets eza consume the directory as --classify's value.
    export FZF_CTRL_T_OPTS=${FZF_CTRL_T_OPTS// -1F / -1 --classify=always -- }
    export FZF_ALT_C_OPTS=${FZF_ALT_C_OPTS// -1F / -1 --classify=always -- }
  fi
fi

# zsh-vi-mode recreates keymaps, so plugin and custom bindings are applied here.
_configure_vi_keybindings() {
  local keymap
  if (( ${+widgets[fzf-file-widget]} )); then
    for keymap in viins vicmd; do
      zvm_bindkey "$keymap" '^T' fzf-file-widget
      zvm_bindkey "$keymap" '\ec' fzf-cd-widget
      zvm_bindkey "$keymap" '^R' fzf-history-widget
    done
  fi

  zvm_bindkey viins '^[[A' history-substring-search-up
  zvm_bindkey viins '^[[B' history-substring-search-down
  zvm_bindkey vicmd 'k' history-substring-search-up
  zvm_bindkey vicmd 'j' history-substring-search-down

  zvm_bindkey viins '^[[C' deselect-forward-char
  zvm_bindkey viins '^[[D' deselect-backward-char
  zvm_bindkey viins '^[OC' deselect-forward-char
  zvm_bindkey viins '^[OD' deselect-backward-char
  zvm_bindkey viins '^[[1;5C' deselect-forward-word
  zvm_bindkey viins '^[[1;5D' deselect-backward-word
  zvm_bindkey viins '^[^[[C' deselect-forward-word
  zvm_bindkey viins '^[^[[D' deselect-backward-word
  zvm_bindkey viins '^[[H' deselect-beginning-of-line
  zvm_bindkey viins '^[[F' deselect-end-of-line
  zvm_bindkey viins '^[[1~' deselect-beginning-of-line
  zvm_bindkey viins '^[[4~' deselect-end-of-line
  [[ -n ${terminfo[khome]} ]] &&
    zvm_bindkey viins "$terminfo[khome]" deselect-beginning-of-line
  [[ -n ${terminfo[kend]} ]] &&
    zvm_bindkey viins "$terminfo[kend]" deselect-end-of-line
  zvm_bindkey viins '^A' deselect-beginning-of-line
  zvm_bindkey viins '^E' deselect-end-of-line

  zvm_bindkey viins '^[[1;2C' visual-select-forward
  zvm_bindkey viins '^[[1;2D' visual-select-backward
  zvm_bindkey viins '^[[1;2A' visual-select-up
  zvm_bindkey viins '^[[1;2B' visual-select-down
  zvm_bindkey viins '^[[1;6C' visual-select-forward-word
  zvm_bindkey viins '^[[1;6D' visual-select-backward-word
  zvm_bindkey viins '^[[1;2H' visual-select-beginning-of-line
  zvm_bindkey viins '^[[1;2F' visual-select-end-of-line
}
zvm_after_init_commands+=(_configure_vi_keybindings)
zvm_after_lazy_keybindings_commands+=(_configure_vi_keybindings)

# -- Lazy Completion ---------------------------------------------------------

if (( ${+commands[uv]} && ${+functions[compdef]} )); then
  _uv_lazy_completion() {
    local completion
    completion=$(uv generate-shell-completion zsh) || return
    eval "$completion" || return
    _uv "$@"
  }
  compdef _uv_lazy_completion uv
fi

if (( ${+commands[uvx]} && ${+functions[compdef]} )); then
  _uvx_lazy_completion() {
    local completion
    completion=$(uvx --generate-shell-completion zsh) || return
    eval "$completion" || return
    _uvx "$@"
  }
  compdef _uvx_lazy_completion uvx
fi

# -- Aliases and Autoloaded Functions ----------------------------------------

alias ll='eza -l'
alias la='eza -A'
alias l='eza --classify=always'
autoload -Uz rm y

# -- External Integrations --------------------------------------------------

local tool_init
if (( ${+commands[zoxide]} )); then
  tool_init=$(zoxide init zsh) || return
  eval "$tool_init" || return
fi
unset tool_init

autoload -Uz add-zsh-hook
_sync_tmux_graphical_environment() {
  [[ -n ${TMUX-} && -n ${TMUX_PANE-} ]] || return 0
  local tmux_environment
  tmux_environment=$(tmux show-environment -s -t "$TMUX_PANE" DISPLAY \; \
    show-environment -s -t "$TMUX_PANE" XAUTHORITY) || return
  eval "$tmux_environment"
}
if [[ -n ${TMUX-} && -n ${TMUX_PANE-} ]]; then
  add-zsh-hook preexec _sync_tmux_graphical_environment
  _sync_tmux_graphical_environment
fi

if [[ -n ${HERDR_PANE_ID-} ]]; then
  for _har_hook in $HOME/.config/herdr/plugins/github-installations/herdr-automatic-rename-*/*/checkout/shell/hook.zsh(N); do
    source "$_har_hook"
    break
  done
  unset _har_hook
fi
