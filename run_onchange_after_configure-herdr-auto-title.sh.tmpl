#!/usr/bin/env bash

# Config: {{ include "private_dot_config/herdr-auto-title/config.env" | sha256sum }}
# Installer: {{ include "run_onchange_before_install-herdr-auto-title.sh.tmpl" | sha256sum }}

set -euo pipefail

plugins_json=$(herdr plugin list --json)
jq -e '
  [.result.plugins[] | select(.plugin_id == "herdr.auto-title")] as $matches
  | ($matches | length) == 1
    and $matches[0].enabled
    and any($matches[0].actions[]; .id == "restart")
    and all(.result.plugins[]; .plugin_id != "herdr-automatic-rename")
' <<<"$plugins_json" >/dev/null

herdr plugin action invoke herdr.auto-title.restart
