# Appearance
theme = Dracula
font-family = JetBrainsMono Nerd Font Mono
font-size = 11
bold-color = bright
cursor-style = block

# Window
window-width = 120
window-height = 30
window-padding-x = 2
window-padding-y = 2
window-padding-balance = true
gtk-tabs-location = top
# Keep opacity consistent in applications that paint their own backgrounds.
background-opacity-cells = true
# Window state restoration is only supported on macOS; ignored on Linux.
window-save-state = always

# Mouse and clipboard
mouse-hide-while-typing = true
copy-on-select = both
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true

# Shell and command completion notifications
shell-integration = detect
# Install remote terminfo and configure SSH terminal compatibility.
shell-integration-features = ssh-env,ssh-terminfo
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
# Keep the default notification threshold of five seconds.

# Quick Terminal template: GNOME/X11 does not support this feature.
# Screen selection supports macOS and Wayland; animation is macOS-only.
# quick-terminal-position = top
# quick-terminal-screen = mouse
# quick-terminal-autohide = true
# quick-terminal-animation-duration = 0.15
# keybind = global:super+g=toggle_quick_terminal

# Leader: press Alt+G, release it, then press the following key.
# These sequences supplement the default Ghostty shortcuts.
# Match the keys after tmux's Alt+J prefix, keeping the leaders separate
# so Ghostty does not consume tmux's prefix.

# Tabs: create, navigate, rename, move, and overview
# c/n/p, Ctrl+n, 1..9, comma, </>, w, and & mirror tmux window operations.
keybind = alt+g>c=new_tab
keybind = alt+g>n=next_tab
keybind = alt+g>ctrl+n=next_tab
keybind = alt+g>p=previous_tab
keybind = alt+g>1=goto_tab:1
keybind = alt+g>2=goto_tab:2
keybind = alt+g>3=goto_tab:3
keybind = alt+g>4=goto_tab:4
keybind = alt+g>5=goto_tab:5
keybind = alt+g>6=goto_tab:6
keybind = alt+g>7=goto_tab:7
keybind = alt+g>8=goto_tab:8
keybind = alt+g>9=goto_tab:9
keybind = alt+g>comma=prompt_tab_title
keybind = alt+g>shift+comma=move_tab:-1
keybind = alt+g>shift+period=move_tab:1
keybind = alt+g>w=toggle_tab_overview
# Shift+W moves the current tab to a new window.
keybind = alt+g>shift+w=move_tab_to_new_window

# Splits: | or % right, backslash left, - or double quote down, _ up
# Use the same split keys as tmux.
keybind = alt+g>shift+backslash=new_split:right
keybind = alt+g>shift+digit_5=new_split:right
keybind = alt+g>backslash=new_split:left
keybind = alt+g>minus=new_split:down
keybind = alt+g>shift+quote=new_split:down
keybind = alt+g>shift+minus=new_split:up

# Focus splits with h/j/k/l, Ctrl+h/j/k/l, or the arrow keys
keybind = alt+g>h=goto_split:left
keybind = alt+g>j=goto_split:down
keybind = alt+g>k=goto_split:up
keybind = alt+g>l=goto_split:right
keybind = alt+g>ctrl+h=goto_split:left
keybind = alt+g>ctrl+j=goto_split:down
keybind = alt+g>ctrl+k=goto_split:up
keybind = alt+g>ctrl+l=goto_split:right
keybind = alt+g>arrow_left=goto_split:left
keybind = alt+g>arrow_down=goto_split:down
keybind = alt+g>arrow_up=goto_split:up
keybind = alt+g>arrow_right=goto_split:right

# Resize by 10 pixels with H/J/K/L
# tmux uses 5 cells per resize; the keys and directions match.
keybind = alt+g>shift+h=resize_split:left,10
keybind = alt+g>shift+j=resize_split:down,10
keybind = alt+g>shift+k=resize_split:up,10
keybind = alt+g>shift+l=resize_split:right,10
# o cycles focus, z toggles zoom, x closes a split, and & closes a tab,
# corresponding to tmux's pane and window operations.
keybind = alt+g>o=goto_split:next
keybind = alt+g>z=toggle_split_zoom
keybind = alt+g>x=close_surface
keybind = alt+g>shift+digit_7=close_tab:this

# Utilities: reload, edit config, search, clipboard, and command palette
# r and Ctrl+c/v mirror tmux; / and ? open Ghostty search and its palette.
keybind = alt+g>r=reload_config
# e edits the config in a new window using the default terminal editor.
keybind = alt+g>e=open_config:new_window
keybind = alt+g>slash=start_search
keybind = alt+g>ctrl+c=copy_to_clipboard
keybind = alt+g>ctrl+v=paste_from_clipboard
keybind = alt+g>shift+slash=toggle_command_palette

# Cancel the sequence, or send a literal Alt+G by pressing Alt+G twice
keybind = alt+g>escape=ignore
keybind = alt+g>alt+g=esc:g
