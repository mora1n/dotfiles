# Zim Modules
# Run `zsh ~/.config/zsh/bootstrap.zsh` after changing this file.

# Environment and interactive utilities.
zmodule environment
zmodule git
zmodule input
zmodule termtitle
zmodule utility
zmodule fzf --if '[[ -t 0 && -t 1 ]]'

# Completion definitions must precede completion initialization.
zmodule zsh-users/zsh-completions --fpath src
zmodule completion

# Highlighting and suggestions must follow completion initialization.
zmodule zdharma-continuum/fast-syntax-highlighting
zmodule zsh-users/zsh-history-substring-search
zmodule zsh-users/zsh-autosuggestions
