#!/usr/bin/env bash

set -euo pipefail

readonly plugin_id="herdr-automatic-rename"
release_json=$(curl -fsSL https://api.github.com/repos/qu8n/herdr-automatic-rename/releases/latest)
plugin_ref=$(jq -er 'select(.draft == false and .prerelease == false) | .tag_name' <<<"$release_json")
plugin_version=${plugin_ref#v}

for required_command in bash curl git herdr jq; do
  if ! command -v "$required_command" >/dev/null 2>&1; then
    printf 'install-herdr-automatic-rename: required command not found: %s\n' "$required_command" >&2
    exit 1
  fi
done

herdr plugin install qu8n/herdr-automatic-rename --ref "$plugin_ref" --yes
plugins_json=$(herdr plugin list --json)

if ! jq -e \
  --arg plugin_id "$plugin_id" \
  --arg plugin_version "$plugin_version" '
  [.result.plugins[] | select(.plugin_id == $plugin_id)] as $matches
  | ($matches | length) == 1
    and $matches[0].enabled
    and $matches[0].version == $plugin_version
    and any($matches[0].actions[]; .id == "reset")
' <<<"$plugins_json" >/dev/null; then
  printf 'install-herdr-automatic-rename: installed plugin metadata did not match the latest release\n' >&2
  exit 1
fi
